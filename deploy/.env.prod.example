# Copy to deploy/.env on the server and fill in. Never commit it.
# Random values:  openssl rand -base64 48  (JWT, Postgres password)   openssl rand -base64 32  (storage key)

# The API's address. Its DNS A record must point at this server, e.g. api.example.com
API_DOMAIN=
POSTGRES_PASSWORD=
JWT_SIGNING_KEY=
# 32 random bytes, base64. Encrypts photos at rest. KEEP A COPY: without it stored photos cannot be read.
STORAGE_ENCRYPTION_KEY=

# Google sign-in: the OAuth *web* client id (the app gets the same value as HALLY_GOOGLE_SERVER_CLIENT_ID)
GOOGLE_CLIENT_ID=
# Sign in with Apple: the iOS bundle id
APPLE_AUDIENCE=app.hally

# AI (OpenAI-compatible). Without a key, photo reading and Ask Hally say they are not available.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_VISION_MODEL=
AI_CHAT_MODEL=
# Shown to users in the AI consent sheet and on the privacy screen, e.g. OpenAI
PRIVACY_AI_PROVIDER_NAME=
# true only if the provider's terms guarantee API data is not used for training
PRIVACY_AI_NO_TRAINING=false

# Shown on the privacy screen: the policy page from site/ (GitHub Pages) and a support address
PRIVACY_CONTACT_EMAIL=
PRIVACY_POLICY_URL=

# Push (Firebase). The service account JSON on one line.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# Free launch: no paywall until in-app purchases are wired up in the app
BILLING_FREE_LAUNCH=true

# Optional
SENTRY_DSN=
ADMIN_API_KEY=
BACKUP_KEEP_DAYS=30
