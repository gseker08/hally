// Copy to Secrets.xcconfig (git-ignored) and fill in from Google Cloud Console → Credentials → your iOS OAuth client
// ("iOS URL scheme"). The client id itself goes to the app: --dart-define=HALLY_GOOGLE_IOS_CLIENT_ID=...
// Without them the iPhone app hides "Google ile devam et" and offers Apple sign-in.
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.1234567890-abcdefg
