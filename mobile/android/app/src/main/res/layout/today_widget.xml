<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen "Today" widget. Filled by TodayWidgetProvider from what the app saved. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/today_widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/today_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/today_widget_title"
            android:textColor="@color/widget_accent"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/today_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"/>
    </LinearLayout>

        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/row1_time"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_accent"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/row1_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="14sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/row2_time"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_accent"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/row2_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="14sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/row3_time"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_accent"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/row3_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="14sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/today_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/today_widget_stale"
            android:textColor="@color/widget_muted"
            android:textSize="13sp"/>
</LinearLayout>
